# ==============================================================================
# AdVantage AI — Enterprise Staging & Production Environment Configuration
# ==============================================================================

# Runtime Environment (development | test | production)
NODE_ENV=production
# Use APP_ENV=staging only for an isolated preview/test deployment. Never set staging flags on production.
APP_ENV=production

# Application HTTP Port (Default: 3000)
PORT=3000

# Application Public Host URL (Used for OAuth redirects and webhook verification)
APP_URL="https://advantage-ai.enterprise.example.com"

# Google Gemini API Key: Required for real-time AI Advertising Copilot generation.
# AI Studio automatically injects this from secrets panel.
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"

# PostgreSQL Database Connection String (Supabase Connection Pooler or Direct URI)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase Cloud Database & Auth Configuration (Free Tier Compatible)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Session Encryption & Cryptographic Token Secret (Recommended in production)
SESSION_SECRET="change_me_to_a_random_32_byte_hex_string"

# Demo shortcuts are strictly opt-in for isolated staging/preview only.
# For a Vercel Preview deployment, set APP_ENV=staging, ENABLE_DEMO_AUTH=true,
# and ENABLE_DEV_OTP_CODE=true in Preview environment variables only.
# Keep all three disabled/production on the Production environment.
ENABLE_DEMO_AUTH="false"
ENABLE_DEV_OTP_CODE="false"

# Rate Limiter Toggle (Set to 'true' in automated test runners or load testing)
DISABLE_RATE_LIMIT="false"

# Ad Provider Sandbox Toggles
META_ADS_ENV="SANDBOX"
GOOGLE_ADS_ENV="SANDBOX"
TIKTOK_ADS_ENV="SANDBOX"
LINKEDIN_ADS_ENV="SANDBOX"

# Optional customer-facing product demo video (HTTPS MP4, YouTube, or Vimeo URL).
# Leave empty to show the built-in interactive walkthrough instead.
VITE_PRODUCT_DEMO_VIDEO_URL=
